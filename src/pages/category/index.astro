---
// テーマ（カテゴリ）一覧ページ。ヘッダーナビ「テーマ」の着地点。
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { CATEGORIES } from '../../data/categories';

const posts = await getCollection('posts', (p) => p.data.status === 'published');

const themes = CATEGORIES.map((c) => ({
  category: c,
  count: posts.filter((p) => p.data.category === c.slug).length,
})).filter((t) => t.count > 0);

const breadcrumbs = [{ label: 'ホーム', href: '/' }, { label: 'テーマ' }];

// 表示名は categories.ts を正本にする（改名時にここを直し忘れないため）
const themeNames = themes.map((t) => t.category.name).join('、');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: c.href
        ? new URL(c.href, Astro.site).href
        : new URL(Astro.url.pathname, Astro.site).href,
    })),
  },
];
---
<BaseLayout
  title="テーマから探す"
  description={`「琥珀時間」の記事をテーマ別にまとめました。${themeNames}の${themes.length}つからお選びいただけます。`}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <h1>テーマから探す</h1>
  <p class="site-tagline">気になるテーマからお読みください。</p>
  <ul class="category-cards">
    {themes.map((t, i) => (
      <CategoryCard category={t.category} count={t.count} eager={i === 0} />
    ))}
  </ul>
</BaseLayout>
