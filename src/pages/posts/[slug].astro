---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// URL規約: /posts/{slug}/ 。slugはfrontmatterで手動固定（公開後変更禁止）
export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => p.data.status === 'published');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
// 全記事はpropsで渡さずここで取得する（数千記事規模でビルド時のprops肥大を避けるため）
const posts = await getCollection('posts', (p) => p.data.status === 'published');
const { Content } = await render(post);
const fmt = (d) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;

// --- 関連記事 ---------------------------------------------------------------
// タグの共有度で並べる。全記事が持つ「紅茶」のような汎用タグに引っ張られないよう、
// 珍しいタグほど重く数える（出現記事数の逆数で重み付け）。
const tagFreq = new Map();
for (const p of posts) {
  for (const t of p.data.tags) tagFreq.set(t, (tagFreq.get(t) ?? 0) + 1);
}
const myTags = new Set(post.data.tags);
const related = posts
  .filter((p) => p.data.slug !== post.data.slug)
  .map((p) => ({
    post: p,
    score: p.data.tags.reduce(
      (s, t) => s + (myTags.has(t) ? 1 / (tagFreq.get(t) ?? 1) : 0),
      0
    ),
  }))
  .sort(
    (a, b) =>
      b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf()
  )
  .slice(0, 3)
  .map((r) => r.post);

// --- 構造化データ -----------------------------------------------------------
// Phase 2でカテゴリを導入したら、パンくずの「ホーム」と記事名の間にカテゴリ階層を挟む。
const breadcrumbs = [
  { label: 'ホーム', href: '/' },
  { label: post.data.title },
];
const siteUrl = Astro.site?.href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: c.href ? new URL(c.href, Astro.site).href : pageUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    image: new URL(post.data.hero, Astro.site).href,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.updated.toISOString(),
    inLanguage: 'ja',
    keywords: post.data.tags.join(', '),
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    author: { '@type': 'Organization', name: '琥珀時間', url: siteUrl },
    publisher: { '@type': 'Organization', name: '琥珀時間', url: siteUrl },
  },
];
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.hero}
  ogType="article"
  publishedDate={post.data.date}
  updatedDate={post.data.updated}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <article>
    <h1>{post.data.title}</h1>
    <p class="post-meta">
      公開: {fmt(post.data.date)}
      {post.data.updated.valueOf() !== post.data.date.valueOf() && ` ／ 更新: ${fmt(post.data.updated)}`}
    </p>
    <img
      src={post.data.hero}
      alt={post.data.title}
      class="hero-image"
      width="1200"
      height="630"
      fetchpriority="high"
      decoding="async"
    />
    <Content />
  </article>

  {related.length > 0 && (
    <aside class="related">
      <h2>あわせて読みたい</h2>
      <ul>
        {related.map((p) => (
          <li>
            <a href={`/posts/${p.data.slug}/`}>{p.data.title}</a>
            <p>{p.data.description}</p>
          </li>
        ))}
      </ul>
      <p class="back-to-list"><a href="/">記事一覧をすべて見る →</a></p>
    </aside>
  )}
</BaseLayout>
