---
// トップの記事一覧。1ページ12件で、13件目以降は /2/ /3/ … に分割する。
// （旧 index.astro を paginate 化したもの。1ページ目のURLは従来どおり / のまま）
// 1ページ目だけランディング構成（ヒーロー→はじめての方へ→テーマ→おすすめ→新着）にする。
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { POSTS_PER_PAGE, compareByDateDescThenSlugAsc } from '../data/pagination';
import { CATEGORIES, categoryPath } from '../data/categories';

export async function getStaticPaths({ paginate }) {
  const posts = [...(await getCollection('posts', (p) => p.data.status === 'published'))]
    .sort(compareByDateDescThenSlugAsc);
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

const { page } = Astro.props;
const siteName = '琥珀時間'; // D-0008
const isFirst = page.currentPage === 1;
const baseDescription =
  '紅茶とティーカップの静かな時間。茶葉の選び方からカップの楽しみまで、丁寧にご紹介するメディア「琥珀時間」です。';

// 2ページ目以降はタイトル・descriptionを変えて重複を避ける（canonicalはBaseLayoutが自ページを指す）
// 1ページ目は siteName と異なる文字列にすることで <title> を「〜｜琥珀時間」にする（BaseLayout側は変更しない）
const title = isFirst ? '紅茶とティーカップの静かな時間' : `記事一覧（${page.currentPage}ページ目）`;
const description = isFirst
  ? baseDescription
  : `${baseDescription}（記事一覧 ${page.currentPage}ページ目）`;

// 1ページ目だけに出す固定スロット。
// slugだけを持ち、タイトル・説明文・サムネイルはコレクション側から引く（テンプレートにべた書きしない）。
const STARTER_SLUGS = [
  'mizudashi-koucha-chaba-erabikata',
  'mizudashi-koucha-hozon-eisei-qa',
  'hot-brew-mizudashi-icetea-hikaku',
  'koucha-shomikigen-kireta-fuumi-mikiwame',
];
const PICKUP_SLUGS = [
  'earl-grey-koucha-brand-kaori-hikaku',
  'wakoucha-nyumon',
  'honey-koucha-erabikata',
  'mizudashi-tea-leaves',
];
const publishedPosts = isFirst
  ? await getCollection('posts', (p) => p.data.status === 'published')
  : [];
const starterPosts = STARTER_SLUGS.map((slug) =>
  publishedPosts.find((p) => p.data.slug === slug)
).filter(Boolean);
const pickupPosts = PICKUP_SLUGS.map((slug) =>
  publishedPosts.find((p) => p.data.slug === slug)
).filter(Boolean);

// 固定スロットのslugが解決できないまま公開されるのを防ぐ（.filter(Boolean) は静かに欠落させるため）
if (isFirst && (starterPosts.length !== STARTER_SLUGS.length || pickupPosts.length !== PICKUP_SLUGS.length)) {
  throw new Error('[home] 固定記事のslugが解決できません。STARTER_SLUGS / PICKUP_SLUGS を確認してください。');
}

// 1ページ目の「新着記事」は先頭6件をカード、残りをテキストリストにする（件数・並び順は変えない）
const recentCards = isFirst ? page.data.slice(0, 6) : page.data;
const recentMore = isFirst ? page.data.slice(6) : [];
---
<BaseLayout
  title={title}
  description={description}
  showRecentPosts={false}
>
  {isFirst ? (
    <section class="home-hero">
      <h1>琥珀時間</h1>
      <p class="site-tagline">紅茶とティーカップの静かな時間</p>
      <p class="site-intro">
        「琥珀時間」は、紅茶とティーカップのある時間を少しだけ丁寧にするための小さなメディアです。茶葉の選び方から淹れ方、器や道具、贈りものまで、暮らしの中で試せることをひとつずつご紹介しています。
      </p>
      <img
        class="home-hero-image"
        src="/images/home/hero.webp"
        width="1400"
        height="735"
        loading="eager"
        decoding="async"
        alt="窓辺のテーブルに置かれた紅茶のティーカップとガラスのティーポット"
      />
    </section>
  ) : (
    <Fragment>
      <p class="site-tagline">紅茶とティーカップの静かな時間</p>
      <h1>記事一覧{!isFirst && `（${page.currentPage}ページ目）`}</h1>
    </Fragment>
  )}
  {isFirst && (
    <section class="home-starter" aria-labelledby="home-starter-heading">
      <h2 id="home-starter-heading" class="home-block-title">はじめての方へ</h2>
      <p class="home-lead">まず読んでほしい4記事です。</p>
      <ul class="post-list">
        {starterPosts.map((post) => <PostCard post={post} />)}
      </ul>
    </section>
  )}
  {isFirst && (
    <nav class="home-themes" aria-labelledby="home-themes-heading">
      <h2 id="home-themes-heading" class="home-block-title">テーマから探す</h2>
      <ul class="home-theme-list">
        {CATEGORIES.map((c) => (
          <li>
            <a class="home-theme-tile" href={categoryPath(c.slug)}>{c.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  {isFirst && (
    <section class="home-pickup" aria-labelledby="home-pickup-heading">
      <h2 id="home-pickup-heading" class="home-block-title">おすすめの記事</h2>
      <ul class="post-list">
        {pickupPosts.map((post) => <PostCard post={post} />)}
      </ul>
    </section>
  )}
  {isFirst && <h2 class="home-block-title">新着記事</h2>}
  {page.data.length === 0 && <p>記事は準備中です。どうぞ楽しみにお待ちください。</p>}
  <ul class="post-list">
    {recentCards.map((post) => <PostCard post={post} />)}
  </ul>
  {recentMore.length > 0 && (
    <ul class="home-recent-more">
      {recentMore.map((post) => (
        <li><a href={`/posts/${post.data.slug}/`}>{post.data.title}</a></li>
      ))}
    </ul>
  )}
  <Pagination page={page} />
  {isFirst && (
    <p class="home-more"><a href="/category/">テーマ一覧をすべて見る →</a></p>
  )}
</BaseLayout>

<style>
  /* トップ1ページ目だけの導線ブロック（/2/ 以降には出さないためページ側に置く）。
     記事カードそのものは共通の .post-list / PostCard をそのまま使う。 */
  .home-block-title {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.5;
    margin: 0 0 0.9rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }
  .home-themes { margin: 0 0 2.5rem; }
  .home-theme-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;   /* スマホは2列 */
    gap: 0.65rem;
  }
  .home-theme-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 56px;
    padding: 0.7rem 0.6rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--accent);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-size: 0.95rem;
    line-height: 1.4;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .home-theme-tile:hover {
    border-color: #d8cec0;
    box-shadow: 0 3px 10px rgba(58, 53, 50, 0.08);
  }
  .home-theme-tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (min-width: 40rem) {
    .home-theme-list { grid-template-columns: repeat(4, 1fr); }   /* PCは4列 */
  }
  .home-starter { margin: 0 0 2.5rem; }
</style>
