---
// トップの記事一覧。1ページ12件で、13件目以降は /2/ /3/ … に分割する。
// （旧 index.astro を paginate 化したもの。1ページ目のURLは従来どおり / のまま）
// 1ページ目だけランディング構成（ヒーロー→はじめての方へ→テーマ→おすすめ→新着）にする。
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { POSTS_PER_PAGE, compareByDateDescThenSlugAsc } from '../data/pagination';
import { getCategory, categoryPath } from '../data/categories';

export async function getStaticPaths({ paginate }) {
  const posts = [...(await getCollection('posts', (p) => p.data.status === 'published'))]
    .sort(compareByDateDescThenSlugAsc);
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

const { page } = Astro.props;
const siteName = '琥珀時間'; // D-0008
const isFirst = page.currentPage === 1;
const baseDescription =
  '紅茶とティーカップの静かな時間。茶葉の選び方からカップの楽しみまで、丁寧にご紹介するメディア「琥珀時間」です。';

// 2ページ目以降はタイトル・descriptionを変えて重複を避ける（canonicalはBaseLayoutが自ページを指す）
// 1ページ目は siteName と異なる文字列にすることで <title> を「〜｜琥珀時間」にする（BaseLayout側は変更しない）
const title = isFirst ? '紅茶とティーカップの静かな時間' : `記事一覧（${page.currentPage}ページ目）`;
const description = isFirst
  ? baseDescription
  : `${baseDescription}（記事一覧 ${page.currentPage}ページ目）`;

// 1ページ目だけに出す固定スロット。
// slugだけを持ち、タイトル・説明文・サムネイルはコレクション側から引く（テンプレートにべた書きしない）。
const STARTER_SLUGS = [
  'aki-moyougae-hitoribun-tea-space',
  'kokyu-koucha-brand-guide',
  '5000en-ika-brand-teacup-hikaku',
  'ouchi-afternoon-tea-hajimekata',
];
const PICKUP_SLUGS = [
  'sekai-sandai-koucha-towa',
  'chaba-grade-op-bop-ctc-yomikata',
  'koucha-kihon-no-irekata',
  'koucha-shomikigen-kireta-fuumi-mikiwame',
];
const publishedPosts = isFirst
  ? await getCollection('posts', (p) => p.data.status === 'published')
  : [];
const starterPosts = STARTER_SLUGS.map((slug) =>
  publishedPosts.find((p) => p.data.slug === slug)
).filter(Boolean);
const pickupPosts = PICKUP_SLUGS.map((slug) =>
  publishedPosts.find((p) => p.data.slug === slug)
).filter(Boolean);

// 固定スロットのslugが解決できないまま公開されるのを防ぐ（.filter(Boolean) は静かに欠落させるため）
if (isFirst && (starterPosts.length !== STARTER_SLUGS.length || pickupPosts.length !== PICKUP_SLUGS.length)) {
  throw new Error('[home] 固定記事のslugが解決できません。STARTER_SLUGS / PICKUP_SLUGS を確認してください。');
}

// トップの主構造「Three Doors」。入口は3つで固定し、4つ目以降のテーマは下段の切り口セクションへ置く。
// 表示名は categories.ts を正本とし、ここには持たない（トップとカテゴリページで名前が食い違わないようにするため）。
const DOORS = [
  { slug: 'tea-leaves', mark: '葉', note: '産地と等級で、味はここまで変わる。', starter: 'chaba-grade-op-bop-ctc-yomikata' },
  { slug: 'how-to', mark: '淹', note: '同じ茶葉でも、淹れ方で別の一杯に。', starter: 'koucha-mizu-nansui-kousui' },
  { slug: 'teaware', mark: '器', note: '器が変わると、紅茶の時間が変わる。', starter: 'teacup-coffee-cup-chigai' },
];
const doors = isFirst
  ? DOORS.map((d) => ({
      ...d,
      category: getCategory(d.slug),
      post: publishedPosts.find((p) => p.data.slug === d.starter),
    }))
  : [];

// カテゴリ定義や記事slugの変更で、扉のリンクが切れたまま公開されるのを防ぐ
if (isFirst && doors.some((d) => !d.category || !d.post)) {
  throw new Error('[home] 扉のカテゴリslugまたは代表記事slugが解決できません。DOORS を確認してください。');
}

// 長いタイトルがカード内で3行に折り返すのを避けるため、「｜」より前だけをリンク文言にする
const doorLinkLabel = (title) => title.split('｜')[0];

// 1ページ目の「新着記事」は先頭6件をカード、残りをテキストリストにする（件数・並び順は変えない）
const recentCards = isFirst ? page.data.slice(0, 6) : page.data;
const recentMore = isFirst ? page.data.slice(6) : [];
---
<BaseLayout
  title={title}
  description={description}
  showRecentPosts={false}
>
  {isFirst ? (
    <section class="home-hero">
      <h1>琥珀時間</h1>
      <p class="site-tagline">紅茶とティーカップの静かな時間</p>
      <p class="site-intro">
        「琥珀時間」は、紅茶とティーカップのある時間を少しだけ丁寧にするための小さなメディアです。茶葉の選び方から淹れ方、器や道具、贈りものまで、暮らしの中で試せることをひとつずつご紹介しています。
      </p>
      <img
        class="home-hero-image"
        src="/images/home/hero.webp"
        width="1400"
        height="735"
        loading="eager"
        decoding="async"
        alt="窓辺のテーブルに置かれた紅茶のティーカップとガラスのティーポット"
      />
    </section>
  ) : (
    <Fragment>
      <p class="site-tagline">紅茶とティーカップの静かな時間</p>
      <h1>記事一覧{!isFirst && `（${page.currentPage}ページ目）`}</h1>
    </Fragment>
  )}
  {isFirst && (
    <section class="home-starter" aria-labelledby="home-starter-heading">
      <h2 id="home-starter-heading" class="home-block-title">はじめての方へ</h2>
      <p class="home-lead">一日のどこかに、湯気の立つ一杯を置く。特別な道具がなくても、紅茶のある時間はここから始められます。</p>
      <ul class="post-list">
        {starterPosts.map((post) => <PostCard post={post} />)}
      </ul>
    </section>
  )}
  {isFirst && (
    <nav class="home-doors" aria-labelledby="home-doors-heading">
      <p class="home-section-label">テーマから探す / Three Doors</p>
      <h2 id="home-doors-heading" class="home-block-title">入口は、三つ。</h2>
      <p class="home-lead">茶葉、淹れ方、器。どこから読んでも、自分の一杯に近づけます。</p>
      <ul class="home-door-list">
        {doors.map((d) => (
          <li class="home-door">
            <span class="home-door-mark" aria-hidden="true">{d.mark}</span>
            <span class="home-door-name">{d.category.name}</span>
            <span class="home-door-note">{d.note}</span>
            <span class="home-door-starter">
              <span class="home-door-starter-label">まず読むなら</span>
              <a href={`/posts/${d.post.data.slug}/`}>{doorLinkLabel(d.post.data.title)}</a>
            </span>
            <a class="home-door-all" href={categoryPath(d.slug)}>{d.category.name}の記事をすべて見る →</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  {isFirst && (
    <nav class="home-selected" aria-labelledby="home-selected-heading">
      <p class="home-section-label">切り口から探す / Selected Themes</p>
      <h2 id="home-selected-heading" class="home-block-title">気になるテーマから探す</h2>
      <ul class="home-selected-list">
        {/* 今後カテゴリを追加する場合はこの一覧へ足す（Three Doors の3つは固定構造のため） */}
        <li>
          <a class="home-selected-item" href={categoryPath('gift')}>
            <span class="home-selected-name">Gift / 手土産</span>
            <span class="home-selected-note">贈りものを選ぶ</span>
          </a>
        </li>
      </ul>
    </nav>
  )}
  {isFirst && (
    <section class="home-pickup" aria-labelledby="home-pickup-heading">
      <h2 id="home-pickup-heading" class="home-block-title">紅茶の基礎知識</h2>
      <p class="home-lead">知る・選ぶ・淹れる・保つ。この4本を順に読むと、紅茶の基本がひととおりつながります。</p>
      <ul class="post-list">
        {pickupPosts.map((post) => <PostCard post={post} />)}
      </ul>
    </section>
  )}
  {isFirst && <h2 class="home-block-title">新着記事</h2>}
  {page.data.length === 0 && <p>記事は準備中です。どうぞ楽しみにお待ちください。</p>}
  <ul class="post-list">
    {recentCards.map((post) => <PostCard post={post} />)}
  </ul>
  {recentMore.length > 0 && (
    <ul class="home-recent-more">
      {recentMore.map((post) => (
        <li><a href={`/posts/${post.data.slug}/`}>{post.data.title}</a></li>
      ))}
    </ul>
  )}
  <Pagination page={page} />
  {isFirst && (
    <p class="home-more"><a href="/category/">テーマ一覧をすべて見る →</a></p>
  )}
</BaseLayout>

<style>
  /* トップ1ページ目だけの導線ブロック（/2/ 以降には出さないためページ側に置く）。
     記事カードそのものは共通の .post-list / PostCard をそのまま使う。 */
  .home-block-title {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.5;
    margin: 0 0 0.9rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }
  /* Three Doors（主構造3つ）と、その下の切り口セクション。
     色・書体は :root のトークンのみを使う。 */
  .home-doors { margin: 0 0 2.5rem; }
  .home-section-label {
    font-family: var(--font-mincho);
    font-size: var(--fs-small);
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin: 0 0 0.35rem;
  }
  .home-door-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .home-door {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1rem 1rem;
    background: var(--color-ivory);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .home-door-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    font-family: var(--font-mincho);
    font-size: 1.15rem;
    line-height: 1;
    color: var(--accent);
  }
  .home-door-name {
    font-family: var(--font-mincho);
    font-size: 1.1rem;
    line-height: 1.4;
    color: var(--ink);
  }
  .home-door-note {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .home-door-starter {
    display: block;
    font-size: 0.9rem;
    line-height: 1.7;
    padding-top: 0.45rem;
    border-top: 1px solid var(--line);
  }
  .home-door-starter-label {
    display: block;
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }
  .home-door-all {
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--accent);
  }
  .home-selected { margin: 0 0 2.5rem; }
  .home-selected-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .home-selected-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    text-decoration: none;
  }
  .home-selected-name {
    font-family: var(--font-mincho);
    font-size: 0.95rem;
    color: var(--accent);
  }
  .home-selected-note {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .home-door-all:focus-visible,
  .home-selected-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .home-selected-item:hover { border-color: var(--color-line-strong); }
  @media (max-width: 1023px) {
    .home-door-list { gap: 0.75rem; }
    .home-door { padding: 0.9rem 0.8rem; }
    .home-selected-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 767px) {
    .home-door-list { grid-template-columns: 1fr; }   /* スマホは1列 */
    .home-selected-list { grid-template-columns: 1fr; }
  }
  .home-starter { margin: 0 0 2.5rem; }
</style>
