---
// サイト共通レイアウト。SEOメタ・OGPはここで一元管理する。
const {
  title,
  description,
  ogImage,       // 記事のhero画像（省略時はOGP画像なし）
  ogType = 'website',
  publishedDate, // 記事のみ
  updatedDate,   // 記事のみ
} = Astro.props;

const siteName = '琥珀時間'; // D-0008
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : null;
---
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="p:domain_verify" content="48a6a7c0d52c75fb649a2be63c6f208d"/>
  <title>{title === siteName ? siteName : `${title}｜${siteName}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
</head>
<body>
  <header class="site-header">
    <a href="/" class="site-title">{siteName}</a>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <p><a href="/about/">運営者情報</a> ／ <a href="/privacy-policy/">プライバシーポリシー</a></p>
    <p>© {new Date().getFullYear()} {siteName}</p>
  </footer>
</body>
</html>

<style is:global>
  /* トーン「上品で静か」: 明朝系見出し・余白多め・低彩度 */
  :root {
    --ink: #3a3532;
    --ink-soft: #6f6862;
    --paper: #fbf9f6;
    --accent: #8c6f4e;
    --line: #e5ded4;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    color: var(--ink);
    background: var(--paper);
    font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", "Noto Sans JP", sans-serif;
    line-height: 1.9;
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  h1, h2, h3, .site-title {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-weight: 600;
    line-height: 1.5;
  }
  a { color: var(--accent); }
  .site-header { padding: 2rem 0 1.5rem; border-bottom: 1px solid var(--line); }
  .site-title { font-size: 1.15rem; color: var(--ink); text-decoration: none; }
  main { padding: 2.5rem 0 4rem; }
  .site-footer { padding: 2rem 0 3rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.85rem; }
  article h1 { font-size: 1.6rem; margin-bottom: 0.75rem; }
  article h2 { font-size: 1.25rem; margin: 2.5rem 0 0.75rem; padding-bottom: 0.3rem; border-bottom: 1px solid var(--line); }
  article h3 { font-size: 1.05rem; margin: 1.75rem 0 0.5rem; }
  article p { margin: 1rem 0; }
  article ul, article ol { margin: 1rem 0 1rem 1.5rem; }
  article img { max-width: 100%; height: auto; }
  article table { border-collapse: collapse; margin: 1.25rem 0; width: 100%; font-size: 0.92rem; }
  article th, article td { border: 1px solid var(--line); padding: 0.5rem 0.75rem; text-align: left; }
  article th { background: #f3eee6; }
  .post-meta { color: var(--ink-soft); font-size: 0.85rem; margin-bottom: 2rem; }
  .hero-image { width: 100%; height: auto; border-radius: 4px; margin-bottom: 2rem; }
  .post-list { list-style: none; margin: 0; }
  .post-list li { padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .post-list a { font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif; font-size: 1.1rem; text-decoration: none; }
  .post-list p { color: var(--ink-soft); font-size: 0.9rem; margin-top: 0.35rem; }
  .site-tagline { color: var(--ink-soft); font-size: 0.9rem; margin-bottom: 1.5rem; }
</style>
