---
// サイト共通レイアウト。SEOメタ・OGP・ナビゲーション・構造化データはここで一元管理する。
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../data/categories';
import { compareByDateDescThenSlugAsc } from '../data/pagination';

const {
  title,
  description,
  ogImage,       // 記事のhero画像（省略時はOGP画像なし）
  ogType = 'website',
  publishedDate, // 記事のみ
  updatedDate,   // 記事のみ
  breadcrumbs = null, // [{ label, href }] 最後の要素は現在地（hrefなしでも可）
  jsonLd = null,      // ページ固有の構造化データ（配列）
  showRecentPosts = true, // 記事一覧そのものであるページ（トップ・ページ送り）では二重になるため出さない
} = Astro.props;

const siteName = '琥珀時間'; // D-0008
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : null;

// フッターの回遊導線用（全ページ共通・新着6件）
const publishedPosts = await getCollection('posts', (p) => p.data.status === 'published');
const footerPosts = [...publishedPosts]
  .sort(compareByDateDescThenSlugAsc)
  .slice(0, 6);
// 記事が1本もないカテゴリは導線に出さない（空ページへ送らない）
const footerCategories = CATEGORIES.filter((c) =>
  publishedPosts.some((p) => p.data.category === c.slug)
);

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: '紅茶とティーカップの静かな時間',
  url: Astro.site?.href,
};
const structuredData = [siteJsonLd, ...(jsonLd ?? [])];
---
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="p:domain_verify" content="48a6a7c0d52c75fb649a2be63c6f208d"/>
  <meta name="google-site-verification" content="s7dAbTeRnz0FFT7ZD7iVzDROZJr4bf1IHLk5BWSngf4" />
  <title>{title === siteName ? siteName : `${title}｜${siteName}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-T1TCDKDQ9S"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-T1TCDKDQ9S');
  </script>
</head>
<body>
  <header class="site-header">
    <a href="/" class="site-title">{siteName}</a>
    <nav class="site-nav" aria-label="メインメニュー">
      <a href="/">ホーム</a>
      <a href="/category/">テーマ</a>
      <a href="/about/">このサイトについて</a>
    </nav>
  </header>
  <main>
    {breadcrumbs && (
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <ol>
          {breadcrumbs.map((c, i) => (
            <li>
              {c.href && i < breadcrumbs.length - 1
                ? <a href={c.href}>{c.label}</a>
                : <span aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
  </main>
  <footer class="site-footer">
    {showRecentPosts && (
      <nav class="footer-posts" aria-label="最近の記事">
        <h2>最近の記事</h2>
        <ul>
          {footerPosts.map((post) => (
            <li><a href={`/posts/${post.data.slug}/`}>{post.data.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <nav class="footer-categories" aria-label="テーマ">
      <h2>テーマから探す</h2>
      <ul>
        {footerCategories.map((c) => (
          <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>
        ))}
      </ul>
    </nav>
    <p class="footer-links">
      <a href="/">ホーム</a> ／ <a href="/category/">テーマ</a> ／ <a href="/about/">運営者情報</a> ／ <a href="/privacy-policy/">プライバシーポリシー</a>
    </p>
    <p>© {new Date().getFullYear()} {siteName} (Kohaku Jikan) / Tea and Cups</p>
  </footer>
</body>
</html>

<style is:global>
  /* トーン「上品で静か」: 明朝系見出し・余白多め・低彩度 */
  :root {
    --ink: #3a3532;
    --ink-soft: #6f6862;
    --paper: #fbf9f6;
    --accent: #8c6f4e;
    --line: #e5ded4;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    color: var(--ink);
    background: var(--paper);
    font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", "Noto Sans JP", sans-serif;
    line-height: 1.9;
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  h1, h2, h3, .site-title {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-weight: 600;
    line-height: 1.5;
  }
  a { color: var(--accent); }
  .site-header {
    padding: 1.75rem 0 1.25rem;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
  }
  .site-title { font-size: 1.15rem; color: var(--ink); text-decoration: none; }
  .site-nav { display: flex; gap: 1.25rem; font-size: 0.9rem; }
  .site-nav a { color: var(--ink-soft); text-decoration: none; padding: 0.25rem 0; }
  .site-nav a:hover { color: var(--accent); }
  main { padding: 2.5rem 0 4rem; }

  /* パンくずリスト */
  .breadcrumb { font-size: 0.8rem; color: var(--ink-soft); margin-bottom: 1.5rem; }
  .breadcrumb ol { list-style: none; margin: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .breadcrumb li + li::before { content: "›"; margin-right: 0.3rem; color: var(--line); }
  .breadcrumb a { color: var(--ink-soft); }
  .breadcrumb span { color: var(--ink-soft); }

  .site-footer { padding: 2.5rem 0 3rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.85rem; }
  .footer-posts h2 {
    font-size: 0.9rem; color: var(--ink); margin-bottom: 0.75rem;
    font-weight: 600; border: none; padding: 0;
  }
  .footer-posts ul { list-style: none; margin: 0 0 2rem; }
  .footer-posts li { padding: 0.4rem 0; }
  .footer-posts a { color: var(--ink-soft); text-decoration: none; }
  .footer-posts a:hover { color: var(--accent); text-decoration: underline; }
  .footer-categories h2 {
    font-size: 0.9rem; color: var(--ink); margin-bottom: 0.75rem;
    font-weight: 600; border: none; padding: 0;
  }
  .footer-categories ul {
    list-style: none; margin: 0 0 2rem;
    display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem;
  }
  .footer-categories a { color: var(--ink-soft); text-decoration: none; }
  .footer-categories a:hover { color: var(--accent); text-decoration: underline; }
  .footer-links { margin-bottom: 0.5rem; }

  article h1 { font-size: 1.6rem; margin-bottom: 0.75rem; }
  article h2 { font-size: 1.25rem; margin: 2.5rem 0 0.75rem; padding-bottom: 0.3rem; border-bottom: 1px solid var(--line); }
  article h3 { font-size: 1.05rem; margin: 1.75rem 0 0.5rem; }
  article p { margin: 1rem 0; }
  article ul, article ol { margin: 1rem 0 1rem 1.5rem; }
  article img { max-width: 100%; height: auto; }
  article table { border-collapse: collapse; margin: 1.25rem 0; width: 100%; font-size: 0.92rem; }
  article th, article td { border: 1px solid var(--line); padding: 0.5rem 0.75rem; text-align: left; }
  article th { background: #f3eee6; }
  /* スマホ幅では表を1行=1カードの縦積みに組み替える（列数が狭すぎて崩れるのを防ぐ）。
     data-label は rehype-table-labels.mjs がビルド時に各tdへ付与する（記事Markdownは無改変）。 */
  @media (max-width: 30rem) {
    article table { border: none; }
    article thead { display: none; }
    article tbody, article tr, article td { display: block; }
    article tr {
      margin-bottom: 1rem;
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 0.25rem 1rem;
    }
    article tr:last-child { margin-bottom: 0; }
    article td {
      border: none;
      border-bottom: 1px solid var(--line);
      padding: 0.6rem 0;
    }
    article td:last-child { border-bottom: none; }
    article td::before {
      content: attr(data-label);
      display: block;
      color: var(--ink-soft);
      font-size: 0.78rem;
      margin-bottom: 0.2rem;
    }
  }
  .post-meta { color: var(--ink-soft); font-size: 0.85rem; margin-bottom: 2rem; }
  .hero-image { width: 100%; height: auto; aspect-ratio: 1200 / 630; border-radius: 4px; margin-bottom: 2rem; }
  .site-tagline { color: var(--ink-soft); font-size: 0.9rem; margin-bottom: 1.5rem; }

  /* 記事カード（トップ・カテゴリ一覧・関連記事で共通・PostCard.astro） */
  .post-list { list-style: none; margin: 0; }
  .post-card { border-bottom: 1px solid var(--line); }
  .post-card:last-child { border-bottom: none; }
  .post-card-link {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.15rem 0;
    text-decoration: none;
    color: inherit;
  }
  .post-card-thumb {
    flex: 0 0 7.5rem;
    width: 7.5rem;
    height: auto;
    aspect-ratio: 480 / 252;   /* hero(1400x735)と同比率。読み込み前も枠を確保しCLSを防ぐ */
    object-fit: cover;
    border-radius: 3px;
    background: #f3eee6;
  }
  .post-card-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .post-card-title {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--accent);
  }
  /* description全文（100〜120字）を出すと1枚250px近くなり一覧が流し読みできない。3行で打ち切る */
  .post-card-desc {
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .post-card-link:hover .post-card-title { text-decoration: underline; }
  @media (max-width: 30rem) {
    .post-card-thumb { flex: 0 0 6.5rem; width: 6.5rem; }
    .post-card-link { gap: 0.85rem; }
  }

  /* テーマ（カテゴリ）一覧のカード（CategoryCard.astro）。モバイル1カラム→広い画面で2カラム */
  .category-cards {
    list-style: none;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .category-card { min-width: 0; }
  .category-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .category-card-link:hover,
  .category-card-link:focus-visible {
    box-shadow: 0 4px 14px rgba(58, 53, 50, 0.09);
    transform: translateY(-2px);
    border-color: #d8cec0;
  }
  .category-card-link:active { transform: translateY(0); }
  .category-card-figure {
    display: block;
    aspect-ratio: 16 / 9;
    /* 画像が未配置でも枠が崩れないよう、落ち着いた無地で埋めておく */
    background: #efe8dd;
  }
  .category-card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .category-card-body { display: block; padding: 1rem 1.15rem 1.25rem; }
  .category-card-title {
    display: block;
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-size: 1.1rem;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .category-card-count { font-family: inherit; font-size: 0.85rem; color: var(--ink-soft); }
  .category-card-desc {
    display: block;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .category-card-link:hover .category-card-title { text-decoration: underline; }
  @media (min-width: 34rem) {
    .category-cards { grid-template-columns: 1fr 1fr; gap: 1.25rem 1.15rem; }
  }
  .back-to-list { margin-top: 1.75rem; font-size: 0.9rem; }

  /* トップの導入文 */
  .site-intro { color: var(--ink-soft); font-size: 0.92rem; margin: 0.75rem 0 1.75rem; }

  /* ページ送り（Pagination.astro） */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .pagination-link { text-decoration: none; padding: 0.5rem 0.25rem; }
  .pagination-link:hover { text-decoration: underline; }
  .pagination-link.is-disabled { color: var(--line); }
  .pagination-current { color: var(--ink-soft); font-size: 0.85rem; }

  /* 記事の目次（rehype-toc.mjs が本文の先頭に差し込む） */
  .toc {
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #f7f2ea;
    padding: 0.4rem 1rem;
    margin: 1.75rem 0;
    font-size: 0.92rem;
  }
  .toc > summary {
    cursor: pointer;
    padding: 0.55rem 0;
    color: var(--ink);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
  }
  article .toc ul { list-style: none; margin: 0.25rem 0 0.75rem; }
  .toc li { padding: 0.3rem 0; line-height: 1.7; }
  .toc a { text-decoration: none; }
  .toc a:hover { text-decoration: underline; }

  /* 記事メタのカテゴリバッジ */
  .post-category {
    display: inline-block;
    font-size: 0.78rem;
    color: var(--ink-soft);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
    margin-bottom: 0.6rem;
  }
  .post-category:hover { color: var(--accent); border-color: var(--accent); }

  /* 記事末の関連記事（回遊導線） */
  .related {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .related > h2 {
    font-size: 1.1rem;
    margin: 0 0 1rem;
    border: none;
    padding: 0;
  }
  .related .back-to-list { margin-top: 1.5rem; font-size: 0.9rem; }

  /* 記事末の運営者情報（posts/[slug].astro が出力・関連記事の有無に関わらず常時表示） */
  .site-operator {
    margin-top: 3rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #f7f2ea;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.85;
  }
  .site-operator > h2 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
    border: none;
    padding: 0;
    color: var(--ink);
  }
  .site-operator p { margin: 0.5rem 0 0; }
  .site-operator p:first-of-type { margin-top: 0; }

  /* 商品ブロックのカード化（記事Markdownは無改変）。
     包む処理は rehype-affiliate-links.mjs がビルド時に行い、ここは見た目だけを持つ。
     .product-card        … カード本体（画像段落＋★段落／画像と★が同一段落／★段落単独）
     .product-card__image … 画像だけのsponsored段落（無い記事もある）
     .product-card__meta  … ★評価＋テキストリンクの段落（必ずある。画像を含む場合もある）
     記事側で画像行と★行の間に空行が無い書き方をしていても同じ見た目になるよう、
     画像のサイズ指定とボタン化は段落の位置ではなくリンクの中身（<img>の有無）で振り分ける。
     ★行が箇条書きの記事など、対象条件を満たさないものはカード化されず従来の見た目のままになる。 */
  .product-card {
    margin: 2rem 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  article .product-card__image {
    margin: 0;
    padding: 1.25rem 1.25rem 0;
    text-align: center;
  }
  article .product-card__meta {
    margin: 0;
    padding: 0 1.25rem 1.25rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  /* 画像段落が無いカード・画像と★が同一段落のカードでは★段落が先頭に来るため、
     上の余白を画像段落ありと同じ厚みに戻す（どちらの書き方でも上下の余白が揃う） */
  article .product-card__meta:first-child {
    padding-top: 1.25rem;
  }
  /* 画像を含むリンクは画像のまま（ボタンにしない）。段落をまたいでも中央に置く */
  .product-card a:has(img) {
    display: block;
    text-decoration: none;
  }
  .product-card img {
    display: block;
    margin: 0 auto 0.9rem;   /* 下の余白が画像と★行の間隔になる（段落が分かれていても同じ） */
    width: min(240px, 100%);
    aspect-ratio: 1 / 1;   /* 商品画像は全記事600×600で統一。読み込み前に枠を確保しCLSを防ぐ */
    max-height: 280px;
    height: auto;
    object-fit: contain;
  }
  /* テキストリンク（画像を含まないもの）をボタンにする */
  .product-card a[rel~="sponsored"]:not(:has(img)) {
    display: block;
    margin-top: 0.65rem;
    padding: 0.7rem 1rem;
    min-height: 44px;
    background: var(--accent);
    color: #fff;
    font-size: 0.95rem;
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    border-radius: 6px;
    overflow-wrap: anywhere;
    transition: background-color 0.15s ease;
  }
  .product-card a[rel~="sponsored"]:not(:has(img)):hover {
    background: var(--ink);
  }
  .product-card a[rel~="sponsored"]:not(:has(img)):focus-visible {
    background: var(--ink);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (max-width: 30rem) {
    .product-card a[rel~="sponsored"]:not(:has(img)) { font-size: 0.83rem; }
  }
</style>
