---
// サイト共通レイアウト。SEOメタ・OGP・ナビゲーション・構造化データはここで一元管理する。
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../data/categories';

const {
  title,
  description,
  ogImage,       // 記事のhero画像（省略時はOGP画像なし）
  ogType = 'website',
  publishedDate, // 記事のみ
  updatedDate,   // 記事のみ
  breadcrumbs = null, // [{ label, href }] 最後の要素は現在地（hrefなしでも可）
  jsonLd = null,      // ページ固有の構造化データ（配列）
} = Astro.props;

const siteName = '琥珀時間'; // D-0008
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : null;

// フッターの回遊導線用（全ページ共通・新着6件）
const publishedPosts = await getCollection('posts', (p) => p.data.status === 'published');
const footerPosts = [...publishedPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
// 記事が1本もないカテゴリは導線に出さない（空ページへ送らない）
const footerCategories = CATEGORIES.filter((c) =>
  publishedPosts.some((p) => p.data.category === c.slug)
);

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: '紅茶とティーカップの静かな時間',
  url: Astro.site?.href,
};
const structuredData = [siteJsonLd, ...(jsonLd ?? [])];
---
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="p:domain_verify" content="48a6a7c0d52c75fb649a2be63c6f208d"/>
  <meta name="google-site-verification" content="s7dAbTeRnz0FFT7ZD7iVzDROZJr4bf1IHLk5BWSngf4" />
  <title>{title === siteName ? siteName : `${title}｜${siteName}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-T1TCDKDQ9S"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-T1TCDKDQ9S');
  </script>
</head>
<body>
  <header class="site-header">
    <a href="/" class="site-title">{siteName}</a>
    <nav class="site-nav" aria-label="メインメニュー">
      <a href="/">ホーム</a>
      <a href="/category/">テーマ</a>
      <a href="/about/">このサイトについて</a>
    </nav>
  </header>
  <main>
    {breadcrumbs && (
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <ol>
          {breadcrumbs.map((c, i) => (
            <li>
              {c.href && i < breadcrumbs.length - 1
                ? <a href={c.href}>{c.label}</a>
                : <span aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
  </main>
  <footer class="site-footer">
    <nav class="footer-posts" aria-label="最近の記事">
      <h2>最近の記事</h2>
      <ul>
        {footerPosts.map((post) => (
          <li><a href={`/posts/${post.data.slug}/`}>{post.data.title}</a></li>
        ))}
      </ul>
    </nav>
    <nav class="footer-categories" aria-label="テーマ">
      <h2>テーマから探す</h2>
      <ul>
        {footerCategories.map((c) => (
          <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>
        ))}
      </ul>
    </nav>
    <p class="footer-links">
      <a href="/">ホーム</a> ／ <a href="/category/">テーマ</a> ／ <a href="/about/">運営者情報</a> ／ <a href="/privacy-policy/">プライバシーポリシー</a>
    </p>
    <p>© {new Date().getFullYear()} {siteName}</p>
  </footer>
</body>
</html>

<style is:global>
  /* トーン「上品で静か」: 明朝系見出し・余白多め・低彩度 */
  :root {
    --ink: #3a3532;
    --ink-soft: #6f6862;
    --paper: #fbf9f6;
    --accent: #8c6f4e;
    --line: #e5ded4;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    color: var(--ink);
    background: var(--paper);
    font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", "Noto Sans JP", sans-serif;
    line-height: 1.9;
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  h1, h2, h3, .site-title {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-weight: 600;
    line-height: 1.5;
  }
  a { color: var(--accent); }
  .site-header {
    padding: 1.75rem 0 1.25rem;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
  }
  .site-title { font-size: 1.15rem; color: var(--ink); text-decoration: none; }
  .site-nav { display: flex; gap: 1.25rem; font-size: 0.9rem; }
  .site-nav a { color: var(--ink-soft); text-decoration: none; padding: 0.25rem 0; }
  .site-nav a:hover { color: var(--accent); }
  main { padding: 2.5rem 0 4rem; }

  /* パンくずリスト */
  .breadcrumb { font-size: 0.8rem; color: var(--ink-soft); margin-bottom: 1.5rem; }
  .breadcrumb ol { list-style: none; margin: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .breadcrumb li + li::before { content: "›"; margin-right: 0.3rem; color: var(--line); }
  .breadcrumb a { color: var(--ink-soft); }
  .breadcrumb span { color: var(--ink-soft); }

  .site-footer { padding: 2.5rem 0 3rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.85rem; }
  .footer-posts h2 {
    font-size: 0.9rem; color: var(--ink); margin-bottom: 0.75rem;
    font-weight: 600; border: none; padding: 0;
  }
  .footer-posts ul { list-style: none; margin: 0 0 2rem; }
  .footer-posts li { padding: 0.4rem 0; }
  .footer-posts a { color: var(--ink-soft); text-decoration: none; }
  .footer-posts a:hover { color: var(--accent); text-decoration: underline; }
  .footer-categories h2 {
    font-size: 0.9rem; color: var(--ink); margin-bottom: 0.75rem;
    font-weight: 600; border: none; padding: 0;
  }
  .footer-categories ul {
    list-style: none; margin: 0 0 2rem;
    display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem;
  }
  .footer-categories a { color: var(--ink-soft); text-decoration: none; }
  .footer-categories a:hover { color: var(--accent); text-decoration: underline; }
  .footer-links { margin-bottom: 0.5rem; }

  article h1 { font-size: 1.6rem; margin-bottom: 0.75rem; }
  article h2 { font-size: 1.25rem; margin: 2.5rem 0 0.75rem; padding-bottom: 0.3rem; border-bottom: 1px solid var(--line); }
  article h3 { font-size: 1.05rem; margin: 1.75rem 0 0.5rem; }
  article p { margin: 1rem 0; }
  article ul, article ol { margin: 1rem 0 1rem 1.5rem; }
  article img { max-width: 100%; height: auto; }
  article table { border-collapse: collapse; margin: 1.25rem 0; width: 100%; font-size: 0.92rem; }
  article th, article td { border: 1px solid var(--line); padding: 0.5rem 0.75rem; text-align: left; }
  article th { background: #f3eee6; }
  .post-meta { color: var(--ink-soft); font-size: 0.85rem; margin-bottom: 2rem; }
  .hero-image { width: 100%; height: auto; aspect-ratio: 1200 / 630; border-radius: 4px; margin-bottom: 2rem; }
  .site-tagline { color: var(--ink-soft); font-size: 0.9rem; margin-bottom: 1.5rem; }

  /* 記事カード（トップ・カテゴリ一覧・関連記事で共通・PostCard.astro） */
  .post-list { list-style: none; margin: 0; }
  .post-card { border-bottom: 1px solid var(--line); }
  .post-card:last-child { border-bottom: none; }
  .post-card-link {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.15rem 0;
    text-decoration: none;
    color: inherit;
  }
  .post-card-thumb {
    flex: 0 0 7.5rem;
    width: 7.5rem;
    height: auto;
    aspect-ratio: 480 / 252;   /* hero(1400x735)と同比率。読み込み前も枠を確保しCLSを防ぐ */
    object-fit: cover;
    border-radius: 3px;
    background: #f3eee6;
  }
  .post-card-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .post-card-title {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--accent);
  }
  .post-card-desc { color: var(--ink-soft); font-size: 0.85rem; line-height: 1.7; }
  .post-card-link:hover .post-card-title { text-decoration: underline; }
  @media (max-width: 30rem) {
    .post-card-thumb { flex: 0 0 5.75rem; width: 5.75rem; }
    .post-card-link { gap: 0.8rem; }
  }

  /* テーマ（カテゴリ）一覧 */
  .category-list { list-style: none; margin: 0; }
  .category-list li { padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .category-list a {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-size: 1.1rem;
    text-decoration: none;
  }
  .category-list .count { font-family: inherit; font-size: 0.85rem; color: var(--ink-soft); }
  .category-list p { color: var(--ink-soft); font-size: 0.9rem; margin-top: 0.35rem; }
  .back-to-list { margin-top: 1.75rem; font-size: 0.9rem; }

  /* 記事メタのカテゴリバッジ */
  .post-category {
    display: inline-block;
    font-size: 0.78rem;
    color: var(--ink-soft);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
    margin-bottom: 0.6rem;
  }
  .post-category:hover { color: var(--accent); border-color: var(--accent); }

  /* 記事末の関連記事（回遊導線） */
  .related {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .related > h2 {
    font-size: 1.1rem;
    margin: 0 0 1rem;
    border: none;
    padding: 0;
  }
  .related .back-to-list { margin-top: 1.5rem; font-size: 0.9rem; }
</style>
