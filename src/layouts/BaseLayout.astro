---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../data/categories';
import { compareByDateDescThenSlugAsc } from '../data/pagination';
import '../styles/global.css';
const { title, description, ogImage, ogType = 'website', publishedDate, updatedDate, breadcrumbs = null, jsonLd = null, showRecentPosts = true, pageClass = '' } = Astro.props;
const siteName = '琥珀時間';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : null;
const publishedPosts = await getCollection('posts', (p) => p.data.status === 'published');
const footerPosts = [...publishedPosts].sort(compareByDateDescThenSlugAsc).slice(0, 5);
const footerCategories = CATEGORIES.filter((c) => publishedPosts.some((p) => p.data.category === c.slug));
const siteJsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: siteName, alternateName: '紅茶とティーカップの静かな時間', url: Astro.site?.href };
const structuredData = [siteJsonLd, ...(jsonLd ?? [])];
---
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#F5EFE4" />
  <meta name="p:domain_verify" content="48a6a7c0d52c75fb649a2be63c6f208d" />
  <meta name="google-site-verification" content="s7dAbTeRnz0FFT7ZD7iVzDROZJr4bf1IHLk5BWSngf4" />
  <title>{title === siteName ? siteName : `${title}｜${siteName}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-T1TCDKDQ9S"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-T1TCDKDQ9S');
  </script>
</head>
<body class={pageClass}>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <header class="site-header"><div class="site-header__inner">
    <a href="/" class="brand" aria-label="琥珀時間 トップへ">
      <svg class="brand__icon" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M20.5 14.5c-2.2-2.6 2.2-4.6 0-7.6M26 14.5c-2.2-2.6 2.2-4.6 0-7.6M9 19.5h26v6.5a13 13 0 0 1-26 0zM35 23h2.4a4.6 4.6 0 0 1 0 9.2H33.4M5.5 42.5h33" /></svg>
      <span class="brand__name">琥珀時間</span><span class="brand__en">Kohaku Jikan</span>
    </a>
    <nav class="site-nav" aria-label="メインメニュー"><a href="/#first-steps">はじめての方へ</a><a href="/category/tea-leaves/">茶葉を知る</a><a href="/category/how-to/">淹れる・楽しむ</a><a href="/category/teaware/">器・道具</a><a href="/#themes">その他テーマ</a><a href="/articles/">すべての記事</a></nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu"><span class="menu-toggle__open">メニュー</span><span class="menu-toggle__close">閉じる</span></button>
  </div></header>
  <div class="mobile-menu" id="mobile-menu" hidden><nav aria-label="モバイルメニュー"><a href="/#first-steps">はじめての方へ</a><a href="/category/tea-leaves/">茶葉を知る</a><a href="/category/how-to/">淹れる・楽しむ</a><a href="/category/teaware/">器・道具</a><a href="/#themes">その他テーマ</a><a href="/articles/">すべての記事</a><a href="/about/">このサイトについて</a></nav><p>自分の一杯を、自分で選べるように。</p></div>
  <main id="main" tabindex="-1">
    {breadcrumbs && <nav class="breadcrumb container" aria-label="パンくずリスト"><ol>{breadcrumbs.map((c, i) => <li>{c.href && i < breadcrumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}</ol></nav>}
    <slot />
  </main>
  <footer class="site-footer"><div class="site-footer__inner container">
    <div class="footer-brand"><a href="/" class="brand brand--footer"><span class="brand__name">琥珀時間</span><span class="brand__en">Kohaku Jikan</span></a><p>自分の一杯を、自分で選べるように。</p></div>
    <div class="footer-navs">
      {showRecentPosts && <nav aria-label="最近の記事"><h2>読む</h2>{footerPosts.slice(0, 3).map((post) => <a href={`/posts/${post.data.slug}/`}>{post.data.title}</a>)}</nav>}
      <nav aria-label="テーマ"><h2>テーマ</h2>{footerCategories.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}</nav>
      <nav aria-label="案内"><h2>案内</h2><a href="/articles/">すべての記事</a><a href="/about/">このサイトについて</a><a href="/privacy-policy/">プライバシーポリシー</a><a href="#main">ページの先頭へ ↑</a></nav>
    </div>
    <p class="footer-disclosure">当サイトはアフィリエイトプログラムに参加しています。商品リンクから購入された場合、紹介料が支払われることがあります。</p>
    <p class="footer-copy">© {new Date().getFullYear()} {siteName} Kohaku Jikan</p>
  </div></footer>
  <script is:inline>
    (() => {
      const toggle = document.querySelector('.menu-toggle'), menu = document.getElementById('mobile-menu'); if (!toggle || !menu) return;
      const bg = [document.querySelector('.skip-link'), document.querySelector('.brand'), document.querySelector('.site-nav'), document.getElementById('main'), document.querySelector('.site-footer')].filter(Boolean);
      const close = (restore = true) => { if (toggle.getAttribute('aria-expanded') !== 'true') return; toggle.setAttribute('aria-expanded', 'false'); menu.classList.remove('is-open'); bg.forEach((el) => el.inert = false); document.documentElement.classList.remove('is-menu-open'); setTimeout(() => menu.hidden = true, 180); if (restore) toggle.focus(); };
      const open = () => { menu.hidden = false; requestAnimationFrame(() => menu.classList.add('is-open')); toggle.setAttribute('aria-expanded', 'true'); bg.forEach((el) => el.inert = true); document.documentElement.classList.add('is-menu-open'); menu.querySelector('a')?.focus(); };
      toggle.addEventListener('click', () => toggle.getAttribute('aria-expanded') === 'true' ? close() : open()); menu.addEventListener('click', (e) => { if (e.target.closest('a')) close(false); });
      document.addEventListener('keydown', (e) => { if (toggle.getAttribute('aria-expanded') !== 'true') return; if (e.key === 'Escape') return close(); if (e.key !== 'Tab') return; const items = [toggle, ...menu.querySelectorAll('a')], first = items[0], last = items.at(-1); if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); } else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); } });
      matchMedia('(min-width:1024px)').addEventListener('change', (e) => e.matches && close(false));
      document.addEventListener('click', (e) => { const a = e.target.closest('a[href^="#"]'); if (!a) return; const target = document.querySelector(a.getAttribute('href')); if (target && target.id !== 'main') { target.tabIndex = -1; target.focus({ preventScroll: true }); } });
    })();
  </script>
</body>
</html>
